# ==========================================
# Email Automation & Notification System
# Environment Configuration Template
# ==========================================

# SMTP Configuration (For Outbound Email Dispatch)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=30

# IMAP Configuration (For Inbound Inbox Monitoring)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_TIMEOUT=30

# Email Gateway Credentials
# For Gmail: Use a 16-character App Password, NOT your personal account password.
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password_here
SENDER_NAME=Email Automation System

# Alert & Notification Recipient
NOTIFICATION_EMAIL=alerts@yourdomain.com
CHECK_INTERVAL=300

# Throttling & Rate Limiting Controls
RATE_LIMIT_DELAY=1.0
BATCH_SIZE=50
BATCH_DELAY=60
MAX_RETRIES=3

# Simulation & Safety Mode
# Set to 'true' to safely test/demonstrate UI without sending real emails over the network
# Set to 'false' in production to send live emails via SMTP
DRY_RUN=true

# Tracking & Analytics
TRACKING_ENABLED=true
BASE_URL=http://localhost:8501

# Database Configuration
DB_PATH=emails.db
